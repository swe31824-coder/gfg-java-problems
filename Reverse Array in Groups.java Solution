class Solution {
    public void reverseInGroups(int[] arr, int k) {
        // code here
       int n=arr.length;
       for(int i=0;i<n;i+=k){
           int st=i;
           int en=Math.min(arr.length-1,i+k-1);
           while(st<=en){
               int temp=arr[st];
               arr[st]=arr[en];
               arr[en]=temp;
               st++;
               en--;
           }
       }
    }
}
